# Copy to .env and set your key locally. Do not commit .env.
# All four graph roles use this one RouterAI key (routerai.ru).
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
SUPERVISOR_PROVIDER=routerai
SUPERVISOR_MODEL=google/gemma-3-4b-it
SUPERVISOR_MAX_TOKENS=300
RESEARCH_PROVIDER=routerai
RESEARCH_MODEL=qwen/qwen-2.5-7b-instruct
RESEARCH_MAX_TOKENS=600
WRITER_PROVIDER=routerai
WRITER_MODEL=openai/gpt-4o-mini
WRITER_MAX_TOKENS=2500
GUARDRAILS_PROVIDER=routerai
GUARDRAILS_MODEL=openai/gpt-4o-mini
GUARDRAILS_MAX_TOKENS=1000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
# Optional: only used with *_PROVIDER=openrouter, not RouterAI.
OPENROUTER_API_KEY=
# Optional legacy settings, only used with *_PROVIDER=openai.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Use handbook after full indexing; indexing with --limit creates handbook_sample.
QDRANT_ALIAS=handbook
# Local HTTP API: one worker; lower inference batch size for machines with little RAM.
API_MODEL_THREADS=1
API_RERANK_ENABLED=true
API_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
API_RERANK_BATCH_SIZE=1
API_TOP_K=8
API_CANDIDATES=100
API_RETRIEVAL_K=30
API_RERANK_LIMIT=40
API_MAX_CONTEXT_CHARS=24000
# Local PostgreSQL checkpointer; change both password and URL together.
POSTGRES_PASSWORD=handbook_local
CHECKPOINT_DATABASE_URL=postgresql://handbook:handbook_local@localhost:5433/handbook?connect_timeout=10
# Optional LangSmith tracing (disabled unless explicitly enabled).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gitlab-handbook-agent
